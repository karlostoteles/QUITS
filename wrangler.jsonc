{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quits",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "quits.aircade.xyz", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/t/*", "/n/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE", "class_name": "TableDO" },
      { "name": "LIMITER", "class_name": "LimiterDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "CHAIN", "class_name": "ChainDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableDO", "LimiterDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ChainDO"] }
  ],
  "vars": {
    "NETWORK": "public",
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "AI_DAILY_MAX": "400",
    "WC_PROJECT_ID": "0e3ce5dbd44550d03e1866db08076118",
    "GOOGLE_CLIENT_ID": "172705330362-qnce26l3efvodmjh61iro081rfphfbea.apps.googleusercontent.com",
    "GAME_NETWORK": "public",
    "GAME_CONTRACT": "CAYHWHSNRG6R436BHAHI4Y6IXVPWS3ZTEUBSGZ7ORHSYAK2ORE5UH5UA"
  },
  "observability": { "enabled": true }
}
